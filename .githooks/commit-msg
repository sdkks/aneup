#!/bin/sh
# Thin shim into the pre-commit framework for commit messages (mirrors the
# generated hook). After cloning, activate hooks with:
#   git config core.hooksPath .githooks
if ! command -v pre-commit >/dev/null 2>&1; then
    echo '`pre-commit` not found. Commit-message gates skipped — pip install pre-commit.' 1>&2
    exit 0
fi
HERE="$(cd "$(dirname "$0")" && pwd)"
exec pre-commit hook-impl --config=.pre-commit-config.yaml --hook-type=commit-msg --hook-dir "$HERE" -- "$@"
