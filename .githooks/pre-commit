#!/bin/sh
# Thin shim into the pre-commit framework (mirrors the generated hook).
# The real gates live in .pre-commit-config.yaml. After cloning, activate
# hooks with: git config core.hooksPath .githooks
if ! command -v pre-commit >/dev/null 2>&1; then
    echo '`pre-commit` not found. Gates skipped — pip install pre-commit.' 1>&2
    exit 0
fi
HERE="$(cd "$(dirname "$0")" && pwd)"
exec pre-commit hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit --hook-dir "$HERE" -- "$@"
